APP_NAME=COGNITIVE DECEPTION
APP_ENV=development
API_PREFIX=/api/v1

DATABASE_URL=sqlite:///./cognitive_deception.db
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=honeypot-events
ELASTICSEARCH_URL=http://elasticsearch:9200
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

USE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ENABLE_KAFKA=false
ENABLE_ELASTIC=false
ENABLE_NEO4J=false
ENABLE_REDIS=false

DEMO_AUTO_SEED=true

RESILIENCE_INTERVAL_SECONDS=60
SESSION_IDLE_TIMEOUT_SECONDS=900
